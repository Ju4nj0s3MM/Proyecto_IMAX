PORT=3000
SESSION_SECRET=cambiar_esto

# Conexión a PostgreSQL (misma BD que levanta docker-compose)
PGHOST=localhost
PGPORT=5432
PGUSER=imax_admin
PGPASSWORD=change_me
PGDATABASE=imax

# MOCK=true -> la API responde datos de ejemplo sin necesitar la BD (para avanzar la GUI en paralelo)
MOCK=true
# AUTH_DEV_BYPASS=true -> permite "entrar como" cualquier rol sin validar contraseña (SOLO desarrollo)
AUTH_DEV_BYPASS=true
